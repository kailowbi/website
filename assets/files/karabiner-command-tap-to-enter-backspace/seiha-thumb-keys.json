{
  "title": "seiha式キーバインド：親指キー（command の単押しで Enter / Backspace）",
  "rules": [
    {
      "description": "左 command を単押しすると Enter（200ms 以内に離したとき。押しながら他のキーを押せば普通の command）",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "left_command", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "left_command" }],
          "to_if_alone": [{ "key_code": "return_or_enter" }],
          "to_if_held_down": [{ "key_code": "left_command", "halt": true }],
          "parameters": { "basic.to_if_alone_timeout_milliseconds": 200 }
        }
      ]
    },
    {
      "description": "右 command を単押しすると Backspace（200ms 以内に離したとき。押しながら他のキーを押せば普通の command）",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "right_command", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "right_command" }],
          "to_if_alone": [{ "key_code": "delete_or_backspace" }],
          "to_if_held_down": [{ "key_code": "right_command", "halt": true }],
          "parameters": { "basic.to_if_alone_timeout_milliseconds": 200 }
        }
      ]
    }
  ]
}
